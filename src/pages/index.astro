---
import { Image } from 'astro:assets';
import CtaBand from '../components/CtaBand.astro';
import HypeSections from '../components/HypeSections.astro';
import HypeTyper from '../components/HypeTyper.astro';
import LatestPosts from '../components/LatestPosts.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
import { site } from '../data/site';
import { testimonials } from '../data/testimonials';
import ceoDesk from '../assets/images/ceo-desk.png';
import sarah from '../assets/images/sarah-j-headshot.png';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  description: site.description,
  url: site.url,
  telephone: site.phone,
  address: { '@type': 'PostalAddress', ...site.postalAddress },
};

const featuredServices = services.slice(0, 3);

---

<BaseLayout title={site.name} description={site.description} schema={organizationSchema}>
  <PageHero
    eyebrow="Innovation · Synergy · Solutions"
    title="Solutions. Powered by AI."
    subtitle="We are passionate about delivering innovative solutions in today's fast-paced digital landscape. We built this site with a free template and an AI that has read every About Us page on the internet. Nothing here will surprise you. That is the product."
  >
    <HypeTyper />
    <div class="buttons mt-5">
      <a class="button is-primary is-medium" href="/contact/">Get Started</a>
      <a class="button is-medium is-light is-outlined" href="/services/">Learn More</a>
    </div>

    <Fragment slot="aside">
      <Image
        class="aw-photo"
        src={ceoDesk}
        alt="A Jack Russell Terrier in a navy suit and tie stands on an office chair at a desk, ready to lead."
        widths={[480, 960]}
        sizes="(max-width: 768px) 100vw, 480px"
        loading="eager"
      />
    </Fragment>
  </PageHero>

  <HypeSections />

  <section class="section aw-section aw-section-alt">
    <div class="container">
      <div class="aw-section-head">
        <p class="aw-eyebrow mb-2">What we offer</p>
        <h2 class="title is-2">Solutions that deliver results</h2>
        <p class="subtitle is-6">Results not included. Solutions sold separately.</p>
      </div>

      <div class="columns">
        {
          featuredServices.map((service) => (
            <div class="column is-4">
              <ServiceCard {...service} />
            </div>
          ))
        }
      </div>

      <div class="has-text-centered mt-6">
        <a class="button is-medium is-light is-outlined" href="/services/">See all services</a>
      </div>
    </div>
  </section>

  <section class="section aw-section">
    <div class="container">
      <div class="columns is-vcentered">
        <div class="column is-7">
          <p class="aw-quote mb-4">
            “We are passionate about our passion. Every morning I wake up and ask how we can
            add value. Then I nap, because I am a dog.”
          </p>
          <p class="has-text-weight-semibold">The Jack Russell, Founder</p>
        </div>
        <div class="column is-5 has-text-centered">
          <a class="button is-primary is-medium" href="/contact/">Let's Connect</a>
          <p class="aw-form-note mt-3">Nothing happens after you click. That is our promise.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section aw-section aw-section-alt">
    <div class="container">
      <div class="aw-section-head">
        <p class="aw-eyebrow mb-2">Testimonials</p>
        <h2 class="title is-2">What customers say</h2>
        <p class="subtitle is-6">We do not have customers. These are what they would say.</p>
      </div>

      <div class="columns">
        {
          testimonials.map((testimonial, index) => (
            <div class="column is-4">
              <TestimonialCard {...testimonial} image={index === 0 ? sarah : undefined} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <LatestPosts />

  <CtaBand
    eyebrow="Ready when you are"
    title="Let's take your business to the next level."
    text="We do not know what level you are on. We are confident there is a next one."
    ctaLabel="Get Started"
    ctaHref="/contact/"
  />
</BaseLayout>
