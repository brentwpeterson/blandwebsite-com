---
import BlogCard from '../../components/BlogCard.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts } from '../../utils/posts';

const posts = await getAllPosts();
---

<BaseLayout
  title="Blog"
  description="Thought leadership from Bland Website. Thoughts not guaranteed."
>
  <PageHero
    eyebrow="Insights"
    title="Thought leadership."
    subtitle="One new post a day, written by Claude, ChatGPT or Gemini, with no human editing. See the experiment for how it works."
    compact
  />

  <section class="section aw-section">
    <div class="container">
      {
        posts.length > 0 ? (
          <div class="columns is-multiline is-centered">
            {
              posts.map((post) => (
                <div class="column is-4">
                  <BlogCard
                    title={post.title}
                    description={post.description}
                    pubDate={post.pubDate}
                    tags={post.tags}
                    href={`/blog/${post.slug}/`}
                    readingTime={post.readingTime}
                    image={post.featuredImage}
                    imageAlt={post.featuredImageAlt}
                  />
                </div>
              ))
            }
          </div>
        ) : (
          <p class="has-text-centered">
            No posts yet. <a href="/contact/">Tell us</a> what to write about and we will ignore it.
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>
