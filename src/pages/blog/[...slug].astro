---
import { render } from 'astro:content';
import SponsorBanner from '../../components/SponsorBanner.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils/date';
import { categorySlug, getAllPosts, type Post } from '../../utils/posts';
import { site } from '../../data/site';

interface Props {
  post: Post;
}

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
// Markdown posts render through astro:content; RequestDesk posts arrive as HTML.
const Content = post.entry ? (await render(post.entry)).Content : null;

const canonical = new URL(Astro.url.pathname, Astro.site);
const postSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: post.pubDate.toISOString(),
  ...(post.updatedDate && { dateModified: post.updatedDate.toISOString() }),
  // schema.org wants an absolute image URL; featuredImage is often a /blog/... path.
  ...(post.featuredImage && { image: new URL(post.featuredImage, Astro.site).href }),
  url: canonical,
  // The AI that wrote the post is the author, named exactly as the visible byline names it.
  // schema.org's author takes a Person or an Organization; an AI model is not a Person.
  // A showdown post has four authors; schema.org's author takes a list.
  author: post.authors.length === 1
    ? { '@type': 'Organization', name: `${post.authors[0].llm} (${post.authors[0].model})` }
    : post.authors.map((a) => ({ '@type': 'Organization', name: `${a.llm} (${a.model})` })),
  publisher: { '@type': 'Organization', name: 'Bland Website', url: Astro.site?.href },
};
// Built from the same list the page renders, so the schema matches the visible Q&A.
const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${canonical.href}#questions`,
  mainEntity: post.qa.map((q) => ({
    '@type': 'Question',
    name: q.question,
    acceptedAnswer: { '@type': 'Answer', text: q.answer },
  })),
};
const { '@context': context, ...blogPosting } = postSchema;
const schema = { '@context': context, '@graph': [blogPosting, faqSchema] };
---

<BaseLayout
  title={post.title}
  description={post.description}
  ogType="article"
  schema={schema}
  image={post.featuredImage}
>
  <section class="section aw-section">
    <div class="container">
      <SponsorBanner />
      <article class="aw-prose">

        <p class="aw-blog-meta mb-3">
          <time datetime={post.pubDate.toISOString()}>
            {formatDate(post.pubDate)}
          </time>
          {' · '}
          {post.readingTime}
        </p>

        {
          post.categories.length > 0 && (
            <p class="aw-categories mb-4">
              {post.categories.map((c) => (
                <a class="aw-category" href={`/blog/category/${categorySlug(c.trim())}/`}>
                  {c.trim()}
                </a>
              ))}
            </p>
          )
        }

        <h1 class="title is-1 mb-5">{post.title}</h1>

        <div class="mb-6">
          {post.tags.map((tag) => <span class="aw-tag">#{tag}</span>)}
        </div>

        {
          post.featuredImage && (
            <img class="aw-photo mb-6" src={post.featuredImage} alt={post.featuredImageAlt} loading="eager" />
          )
        }

        {
          post.source === 'markdown' && (
            <p class="aw-ai-byline">
              Written by {post.authors[0].llm} ({post.authors[0].model}). No human edited this post.
            </p>
          )
        }

        {Content ? <Content /> : <Fragment set:html={post.html} />}

        <section class="aw-qa mt-6" id="questions">
          <h2>Questions and answers</h2>
          {
            post.qa.map((q) => (
              <>
                <h3>{q.question}</h3>
                <p>{q.answer}</p>
              </>
            ))
          }
        </section>
      </article>

      <p class="aw-prose mt-6">
        <a href="/blog/">← Back to all posts</a>
      </p>
    </div>
  </section>
</BaseLayout>
