---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us" description="The story of Bland Website, a journey of passion, innovation, and buying a domain on a Monday afternoon.">
	<section class="hero">
		<h1>Our <code><span>Story</span></code></h1>
		<p>
			Bland Website was founded in 2026 by someone who bought a domain on a Monday afternoon. Since
			then we have grown from a single idea into a single page, and then, through sheer
			determination, into four pages.
		</p>
		<p>
			We believe in people. We believe in technology. Most of all, we believe in the power of people
			and technology coming together, which is the sentence every About page has to contain by law.
		</p>
	</section>

	<section class="grid">
		<div class="box">
			<h2>Our Mission</h2>
			<p>To leverage synergy. We were told to write that down and we did.</p>
		</div>
		<div class="box">
			<h2>Our Vision</h2>
			<p>A world where every website looks exactly like this one. We are closer than you think.</p>
		</div>
		<div class="box">
			<h2>Our Values</h2>
			<p>Integrity. Innovation. Whatever the third one usually is.</p>
		</div>
	</section>

	<section class="box testimonial">
		<p class="quote">"This website met my expectations, which were low."</p>
		<p>Sarah J., Satisfied Customer*</p>
		<p class="fine-print">*Not a customer. Not satisfied. Possibly not Sarah.</p>
	</section>
</Layout>

<style>
	.testimonial {
		margin-bottom: 48px;
	}

	.quote {
		font-size: 20px;
		line-height: 1.5;
		color: #111827;
	}
</style>
