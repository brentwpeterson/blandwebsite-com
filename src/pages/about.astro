---
import { Image } from 'astro:assets';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { chairman, team, values } from '../data/team';
import teamPhoto from '../assets/images/team-high-five.png';
---

<BaseLayout
  title="About"
  description="Meet Marlin Blando, Chairman of Bland Website, the team behind the site and the values we picked from a dropdown."
>
  <PageHero
    eyebrow="About us"
    title="Our story."
    subtitle="Founded in 2026 by a Jack Russell and an AI, Bland Website set out to change the way people think about websites. It did not, and here we are."
    compact
  />

  <section class="section aw-section">
    <div class="container">
      <div class="columns is-vcentered">
        <div class="column is-7">
          <h2 class="title is-2 mb-4">Why we exist</h2>
          <div class="content">
            <p>
              Every company needs a website, and every website needs an About page, and every About
              page needs three paragraphs. This is the first paragraph.
            </p>
            <p>
              We believe in collaboration, which is why our team high-fives in every photo. We do not
              know what we are celebrating. We celebrate it often.
            </p>
            <p>
              Today we offer a comprehensive suite of end-to-end services. This is the third
              paragraph, and we are proud to have reached it together.
            </p>
          </div>
        </div>
        <div class="column is-5">
          <Image
            class="aw-photo"
            src={teamPhoto}
            alt="Office workers high-five over a conference table while a Jack Russell Terrier jumps up to join the celebration."
            widths={[480, 960]}
            sizes="(max-width: 768px) 100vw, 420px"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section aw-section aw-section-alt" id="chairman">
    <div class="container">
      <div class="aw-section-head">
        <p class="aw-eyebrow mb-2">Leadership</p>
        <h2 class="title is-2">A letter from our Chairman</h2>
      </div>

      <div class="columns is-centered">
        <div class="column is-8">
          <div class="box aw-card">
            <div class="content">
              {chairman.letter.map((paragraph) => <p>{paragraph}</p>)}
              <p class="mb-4">{chairman.signOff}</p>
            </div>
            <div class="is-flex is-align-items-center">
              <span class="aw-avatar mr-4" aria-hidden="true">{chairman.initials}</span>
              <div>
                <p class="title is-5 mb-1">{chairman.name}</p>
                <p class="aw-form-note">{chairman.role}, Bland Website</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section aw-section">
    <div class="container">
      <div class="aw-section-head">
        <p class="aw-eyebrow mb-2">What guides us</p>
        <h2 class="title is-2">Mission, vision, values</h2>
      </div>

      <div class="columns">
        {
          values.map((value, index) => (
            <div class="column is-4">
              <div class="box aw-card">
                <p class="aw-value-number mb-2">{String(index + 1).padStart(2, '0')}</p>
                <h3 class="title is-5">{value.title}</h3>
                <p>{value.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section aw-section aw-section-alt">
    <div class="container">
      <div class="aw-section-head">
        <p class="aw-eyebrow mb-2">The team</p>
        <h2 class="title is-2">Meet the people (and dog)</h2>
        <p class="subtitle is-6">A dedicated team of professionals. Two of them exist.</p>
      </div>

      <div class="columns">
        {
          team.map((member) => (
            <div class="column is-3">
              <div class="box aw-card">
                <div class="is-flex is-align-items-center mb-4">
                  <span class="aw-avatar mr-4" aria-hidden="true">{member.initials}</span>
                  <div>
                    <h3 class="title is-5 mb-1">{member.name}</h3>
                    <p class="aw-form-note">{member.role}</p>
                  </div>
                </div>
                <p>{member.bio}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Join the journey"
    title="We would love to partner with you."
    text="We do not know what partnering means here either, but the button is very nice."
  />
</BaseLayout>
