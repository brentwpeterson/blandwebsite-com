---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import handshake from '../assets/images/handshake.png';
import support from '../assets/images/support-headset.png';
---

<Layout title="Services" description="Scalable, seamless, end-to-end services that deliver results. Results not included.">
	<section class="hero">
		<h1>Solutions That <code><span>Deliver Results</span></code></h1>
		<p>
			We offer a comprehensive suite of end-to-end services designed to empower your business. If you
			can tell what any of them do, please contact us, because we would also like to know.
		</p>
	</section>

	<Image
		class="photo"
		src={handshake}
		alt="Two business people shake hands on a deal in a bright lobby while a Jack Russell Terrier, the only one who read the contract, looks at the camera."
		widths={[480, 960, 1376]}
		sizes="(max-width: 960px) 100vw, 928px"
	/>

	<section class="grid">
		<div class="box">
			<h2>Seamless Integration</h2>
			<p>We integrate things. Seamlessly. Please do not ask which things.</p>
		</div>
		<div class="box">
			<h2>Scalable Growth</h2>
			<p>This website can comfortably handle up to several visitors at once.</p>
		</div>
		<div class="box">
			<Image
				class="card-photo"
				src={support}
				alt="A Jack Russell Terrier in a call-center headset, ready to not understand your question."
				widths={[320, 640]}
				sizes="(max-width: 768px) 100vw, 300px"
			/>
			<h2>24/7 Support</h2>
			<p>Our chatbot is available around the clock to tell you it did not understand the question.</p>
		</div>
		<div class="box">
			<h2>Digital Transformation</h2>
			<p>We will transform your business into a digital version of the same business.</p>
		</div>
		<div class="box">
			<h2>Thought Leadership</h2>
			<p>We have thoughts. We are leading with them. This is one of them.</p>
		</div>
		<div class="box">
			<h2>Pricing</h2>
			<p>Contact us for pricing. There is no pricing.</p>
		</div>
	</section>

	<section class="links cta">
		<a class="button" href="/contact/">Let's Talk</a>
		<a href="/about/">Learn even more &rarr;</a>
	</section>
</Layout>

<style>
	.card-photo {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 10px;
		margin-bottom: 12px;
	}

	.cta {
		margin-bottom: 48px;
	}
</style>
