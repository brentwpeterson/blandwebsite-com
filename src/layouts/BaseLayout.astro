---
import { ClientRouter } from 'astro:transitions';
import AdSlot from '../components/AdSlot.astro';
import Footer from '../components/Footer.astro';
import NavBar from '../components/NavBar.astro';
import { site } from '../data/site';
import '../assets/styles/main.scss';

interface Props {
  title: string;
  description?: string;
  /** Open Graph type, e.g. "website" (default) or "article" for blog posts. */
  ogType?: string;
  /** JSON-LD structured data (e.g. Organization, BlogPosting). Serialized as-is. */
  schema?: Record<string, unknown>;
  /** Page-specific share image (path or absolute URL). Omit to use the site's /og-image.png. */
  image?: string;
}

const {
  title,
  description = site.description,
  ogType = 'website',
  schema,
  image,
} = Astro.props;

const ogImage = new URL(image ?? '/og-image.png', Astro.site);

const pageTitle = title === site.name ? title : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fontUrl =
  'https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap';
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <!-- Google Analytics 4: property blandwebsite.com (562460582), stream Bland Website -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-7R4KY09NKY"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-7R4KY09NKY');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />


    <!-- Inter, loaded async so it never blocks first paint -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={fontUrl} />
    <link
      rel="stylesheet"
      href={fontUrl}
      media="print"
      onload="this.setAttribute('media', 'all')"
    />

    <!-- Canonical + Open Graph -->
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {/* Width and height are known only for the default image; post images vary in size. */}
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <!-- RSS feed for the blog -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href={new URL('/rss.xml', Astro.site)}
    />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{pageTitle}</title>

    <ClientRouter />

    {
      schema && (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      )
    }
  </head>
  <body>
    <a class="aw-skip-link" href="#main-content">Skip to main content</a>
    <NavBar />
    <main id="main-content">
      <slot />
    </main>
    <AdSlot />
    <Footer />
  </body>
</html>
