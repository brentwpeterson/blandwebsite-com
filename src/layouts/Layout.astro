---
import background from '../assets/background.svg';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'Bland Website delivers innovative, best-in-class solutions to forward-thinking stakeholders. We are not sure what that means either.',
} = Astro.props;

const nav = [
	{ href: '/', label: 'Home' },
	{ href: '/about/', label: 'About' },
	{ href: '/services/', label: 'Services' },
	{ href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title} | Bland Website</title>
	</head>
	<body>
		<img id="background" src={background.src} alt="" fetchpriority="high" />
		<div id="container">
			<header>
				<a href="/" class="logo">Your Logo Here</a>
				<nav aria-label="Main">
					{
						nav.map((item) => (
							<a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
								{item.label}
							</a>
						))
					}
				</nav>
			</header>
			<main>
				<slot />
			</main>
			<footer>
				<p>
					&copy; 2026 Bland Website. All rights reserved, not that anyone asked. Every word and every Jack Russell on this
					site was made by AI, which you probably figured out around "fast-paced digital landscape."
				</p>
			</footer>
		</div>
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}

	#background {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		filter: blur(100px);
	}

	#container {
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		color: #111827;
	}

	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
		padding: 16px 24px;
	}

	.logo {
		border: 2px dashed #9ca3af;
		border-radius: 8px;
		padding: 6px 12px;
		color: #6b7280;
		font-size: 14px;
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	nav {
		display: flex;
		gap: 4px;
		flex-wrap: wrap;
	}

	nav a {
		padding: 8px 12px;
		color: #111827;
		text-decoration: none;
		border-radius: 8px;
		transition: color 0.2s;
	}

	nav a:hover {
		color: rgb(78, 80, 86);
	}

	nav a[aria-current='page'] {
		background: rgba(255, 255, 255, 0.7);
	}

	main {
		flex: 1;
		width: 100%;
		max-width: 960px;
		margin: 0 auto;
		padding: 0 16px;
		box-sizing: border-box;
	}

	footer {
		padding: 24px 16px;
		text-align: center;
	}

	footer p {
		max-width: 640px;
		margin: 0 auto;
		color: #4b5563;
		font-size: 14px;
	}

	.hero {
		display: flex;
		flex-direction: column;
		align-items: start;
		justify-content: center;
		padding: 10vh 0 32px;
	}

	h1 {
		font-size: 22px;
		margin: 0.25em 0 0.5em;
		line-height: 1.5;
	}

	h2 {
		margin: 0 0 0.5em;
		font-weight: normal;
		color: #111827;
		font-size: 20px;
	}

	p {
		color: #4b5563;
		font-size: 16px;
		line-height: 24px;
		letter-spacing: -0.006em;
		margin: 0 0 1em;
	}

	code {
		display: inline-block;
		background:
			linear-gradient(66.77deg, #f3cddd 0%, #f5cee7 100%) padding-box,
			linear-gradient(155deg, #d83333 0%, #f041ff 18%, #f5cee7 45%) border-box;
		border-radius: 8px;
		border: 1px solid transparent;
		padding: 2px 8px;
	}

	code span {
		font-family:
			ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono',
			monospace;
		background: linear-gradient(14deg, #d83333 0%, #f041ff 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.links {
		display: flex;
		gap: 16px;
		flex-wrap: wrap;
	}

	.links a,
	.button {
		display: inline-flex;
		align-items: center;
		padding: 10px 12px;
		color: #111827;
		text-decoration: none;
		transition: color 0.2s;
		font: inherit;
	}

	.button {
		color: white;
		background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.12),
			inset 0 -2px 0 rgba(0, 0, 0, 0.24);
		border: 0;
		border-radius: 10px;
		cursor: pointer;
	}

	.links a.button {
		color: white;
	}

	.button:hover,
	.links a.button:hover {
		color: rgb(230, 230, 230);
		box-shadow: none;
	}

	.box {
		padding: 16px;
		background: rgba(255, 255, 255, 1);
		border-radius: 16px;
		border: 1px solid white;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 16px;
		margin-bottom: 32px;
	}

	.photo {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 16px;
		margin: 0 0 32px;
	}

	.fine-print {
		font-size: 12px;
		color: #6b7280;
	}

	@media screen and (max-width: 768px) {
		header {
			padding: 16px;
		}

		.links a.button {
			padding: 14px 18px;
		}
	}
</style>
