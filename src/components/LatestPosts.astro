---
// Self-contained "latest articles" section for the home page.
// Renders the three most recent blog posts and links to the full listing.
import BlogCard from './BlogCard.astro';
import { getAllPosts } from '../utils/posts';

const posts = (await getAllPosts()).slice(0, 3);
---

<section class="section aw-section">
  <div class="container">
    <div class="aw-section-head">
      <p class="aw-eyebrow mb-2">Thought leadership</p>
      <h2 class="title is-2">Latest insights</h2>
      <p class="subtitle is-6">Fresh takes, written by an AI that has read every other take.</p>
    </div>

    {
      posts.length > 0 ? (
        <div class="columns">
          {
            posts.map((post) => (
              <div class="column is-4">
                <BlogCard
                  title={post.title}
                  description={post.description}
                  pubDate={post.pubDate}
                  tags={post.tags}
                  href={`/blog/${post.slug}/`}
                  readingTime={post.readingTime}
                  image={post.featuredImage}
                  imageAlt={post.featuredImageAlt}
                />
              </div>
            ))
          }
        </div>
      ) : (
        <p class="has-text-centered">No posts yet. Check back never.</p>
      )
    }

    <div class="has-text-centered mt-6">
      <a class="button is-medium is-light is-outlined" href="/blog/">Read more insights</a>
    </div>
  </div>
</section>